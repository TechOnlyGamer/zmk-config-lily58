#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_de.h"

/ {
    behaviors {
        HRM_Left: HRM_Left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 11 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 54 55 56 57>;
        };

        HRM_Right: HRM_Right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53>;
        };
    };

    combos {
        compatible = "zmk,combos";

        sys_layer {
            bindings = <&to 3>;
            key-positions = <52 55>;
            layers = <0>;
        };

        default_layer {
            bindings = <&to 0>;
            key-positions = <52 55>;
            layers = <3>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <25 26 27>;
        };

        a_umlaut {
            bindings = <&kp DE_A_UMLAUT>;
            key-positions = <25 15>;
        };

        u_umlaut {
            bindings = <&kp DE_U_UMLAUT>;
            key-positions = <19 15>;
        };

        o_umlaut {
            bindings = <&kp DE_O_UMLAUT>;
            key-positions = <21 15>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC           &kp DE_N1                &kp DE_N2                &kp DE_N3                  &kp DE_N4             &kp DE_N5                                  &kp DE_N6  &kp DE_N7              &kp DE_N8                    &kp DE_N9                  &kp DE_N0                         &kp DE_SZ
&kp TAB           &kp DE_Q                 &kp DE_W                 &kp DE_E                   &kp DE_R              &kp DE_T                                   &kp DE_Z   &kp DE_U               &kp DE_I                     &kp DE_O                   &kp DE_P                          &kp DE_PLUS
&kp LEFT_SHIFT    &HRM_Left LEFT_GUI DE_A  &HRM_Left LEFT_ALT DE_S  &HRM_Left LEFT_SHIFT DE_D  &HRM_Left LCTRL DE_F  &kp DE_G                                   &kp DE_H   &HRM_Right RCTRL DE_J  &HRM_Right RIGHT_SHIFT DE_K  &HRM_Right RIGHT_ALT DE_L  &HRM_Right RIGHT_GUI DE_O_UMLAUT  &kp DE_HASH
&kp DE_LESS_THAN  &kp DE_Y                 &kp DE_X                 &kp DE_C                   &kp DE_V              &kp DE_B   &kp BACKSPACE    &kp BACKSPACE  &kp DE_N   &kp DE_M               &kp DE_COMMA                 &kp DE_PERIOD              &kp DE_MINUS                      &kp RSHFT
                                                                    &kp LEFT_CONTROL           &kp LEFT_SHIFT        &mo 1      &kp SPACE        &kp RET        &mo 2      &kp LEFT_ALT           &kp RGUI
            >;

            label = "Base";
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp F1    &kp F2    &kp F3    &kp F4     &kp F5          &kp F6                               &kp F7   &kp F8          &kp F9             &kp F10         &kp F11          &kp F12
&kp F13   &kp F14   &kp F15   &kp F16    &kp F17         &kp F18                              &kp F19  &kp F20         &kp F21            &kp F22         &kp F23          &kp F24
&trans    &kp LGUI  &kp LALT  &kp LSHFT  &kp LCTRL       &trans                               &trans   &kp LEFT_ARROW  &kp UP_ARROW       &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp TILDE
&kp PIPE  &trans    &trans    &trans     &trans          &trans   &bt BT_CLR    &out OUT_TOG  &trans   &trans          &trans             &trans          &trans           &trans
                              &kp LCTRL  &kp LEFT_SHIFT  &trans   &trans        &trans        &trans   &kp RIGHT_ALT   &kp RIGHT_COMMAND
            >;

            label = "Function";
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4                              &trans  &trans          &trans             &trans        &trans           &studio_unlock
&trans  &trans        &trans        &trans        &trans          &trans                                    &trans  &mkp LCLK       &msc SCRL_DOWN     &msc SCRL_UP  &mkp RCLK        &kp K_VOLUME_UP
&trans  &trans        &trans        &trans        &trans          &trans                                    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN     &mmv MOVE_UP  &mmv MOVE_RIGHT  &kp K_VOLUME_DOWN
&trans  &trans        &trans        &trans        &trans          &trans        &bt BT_CLR    &out OUT_TOG  &trans  &trans          &mkp MCLK          &trans        &trans           &trans
                                    &kp LCTRL     &kp LEFT_SHIFT  &trans        &trans        &trans        &trans  &kp RIGHT_ALT   &kp RIGHT_COMMAND
            >;

            label = "System";
        };

        Gaming {
            bindings = <
&kp ESC         &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_N4       &kp DE_N5                                  &kp DE_N6  &kp DE_N7      &kp DE_N8     &kp DE_N9      &kp DE_N0        &kp DE_SZ
&kp TAB         &kp DE_Q   &kp DE_W   &kp DE_E   &kp DE_R        &kp DE_T                                   &kp DE_Z   &kp DE_U       &kp DE_I      &kp DE_O       &kp DE_P         &kp DE_PLUS
&trans          &kp DE_A   &kp DE_S   &kp DE_D   &kp DE_F        &kp DE_G                                   &kp DE_H   &kp DE_J       &kp DE_K      &kp DE_L       &kp DE_O_UMLAUT  &kp DE_HASH
&kp LEFT_SHIFT  &kp DE_Y   &kp DE_X   &kp DE_C   &kp DE_V        &kp DE_B   &kp BACKSPACE    &kp BACKSPACE  &kp DE_N   &kp DE_M       &kp DE_COMMA  &kp DE_PERIOD  &kp DE_MINUS     &kp RSHFT
                                      &kp LCTRL  &kp LEFT_SHIFT  &mo 1      &kp SPACE        &kp RET        &mo 2      &kp RIGHT_ALT  &kp RGUI
            >;

            label = "Gaming";
        };
    };
};
